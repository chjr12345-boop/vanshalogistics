{
  "name": "vansha-logistic-hub",
  "private": true,
  "version": "0.1.0",
  "description": "Vansha Logistic Hub - production foundation",
  "workspaces": ["apps/web", "apps/server"],
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:web": "npm --workspace @vansha/web run build",
    "build:server": "npm --workspace @vansha/server run build",
    "lint": "npm run lint:web && npm run lint:server",
    "lint:web": "npm --workspace @vansha/web run lint",
    "lint:server": "npm --workspace @vansha/server run lint",
    "typecheck": "npm run typecheck:web && npm run typecheck:server",
    "typecheck:web": "npm --workspace @vansha/web run typecheck",
    "typecheck:server": "npm --workspace @vansha/server run typecheck",
    "test": "npm run test:server",
    "test:server": "npm --workspace @vansha/server run test"
  }
}