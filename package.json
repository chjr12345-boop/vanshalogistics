{
  "name": "vansha-logistic-hub",
  "private": true,
  "version": "0.1.0",
  "description": "Vansha Logistic Hub foundation",
  "packageManager": "npm@11",
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:web": "npm --prefix apps/web run build",
    "build:server": "npm --prefix apps/server run build",
    "lint": "npm run lint:web && npm run lint:server",
    "lint:web": "npm --prefix apps/web run lint",
    "lint:server": "npm --prefix apps/server run lint",
    "typecheck": "npm run typecheck:web && npm run typecheck:server",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "typecheck:server": "npm --prefix apps/server run typecheck",
    "test": "npm run test:server",
    "test:server": "npm --prefix apps/server run test"
  }
}
